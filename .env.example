# NASA Earthdata Login — create at https://urs.earthdata.nasa.gov/users/new
# earthaccess writes ~/.netrc on first login; no secrets are ever committed
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# LiteLLM gateway (serves ALL models, local and API)
LITELLM_MASTER_KEY=
LITELLM_API_KEY=
LOCAL_INFERENCE_BASE_URL=http://localhost:4000

# API models served through the gateway
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
