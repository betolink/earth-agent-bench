# EAB environment contract — these three are all you need to run EAB.
# Validate with:  uv run eab doctor
EARTHDATA_TOKEN=                 # Earthdata Login token (or EARTHDATA_USERNAME + EARTHDATA_PASSWORD)
LITE_LLM_ENDPOINT=               # LiteLLM gateway base URL, e.g. https://llm.example.org
LITE_LLM_API_KEY=                # gateway bearer token used by the agent harnesses

# Earthdata username/password alternative to EARTHDATA_TOKEN (earthaccess writes ~/.netrc)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Serving side (only needed to stand up the gateway itself, not to run EAB)
LITELLM_MASTER_KEY=
LOCAL_INFERENCE_BASE_URL=http://localhost:4000
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Legacy aliases still accepted as fallbacks
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
